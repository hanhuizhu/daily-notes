# 表单代码生成规则

## 核心规则【强制执行】
- **调用mcp工具 getMrpComponentsDetail 获取组件文档**
- **接口 response 就是数据本身，禁止使用 response.data**
- **Vue 2.6/2.7 双向绑定用 :modelValue.sync，Vue 3.x 用 v-model**
- **Vue 2.7 路由从 vue-router/composables 导入，Vue 2.6 从 instance?.proxy?.$router**
- **消息提示用 MrpMessage，日期选择器用 MarsPC 组件库**
- **MrpUpload 按示例实现，MrpSelect 只用 :options 配置**
- **动态表单必须拆分为独立组件，15个字段以上建议拆分**

## Vue 3.x/2.7 Composition API 模板

```vue
<template>
  <div class="form-container">
    <mrp-card :title="pageTitle">
      <mrp-form ref="formRef" :model="formData" :rules="formRules">
        <!-- 输入框 -->
        <mrp-form-item label="名称" field="name">
          <mrp-input :modelValue="formData.name" @update:modelValue="formData.name = $event" placeholder="请输入" allow-clear />
        </mrp-form-item>

        <!-- 选择器 -->
        <mrp-form-item label="类型" field="type">
          <mrp-select :modelValue="formData.type" @update:modelValue="formData.type = $event" :options="typeOptions" placeholder="请选择" />
        </mrp-form-item>

        <!-- 其他组件：mrp-input-number、mrp-radio-group、mrp-checkbox-group、mrp-cascader、mrp-date-picker、mrp-range-picker、mrp-upload、mrp-textarea 等根据需求使用 -->

        <!-- 动态表单组件 -->
        <mrp-form-item label="联系人" field="contacts">
          <contact-form :modelValue="formData.contacts" @update:modelValue="formData.contacts = $event" />
        </mrp-form-item>

        <!-- 操作按钮 -->
        <mrp-form-item>
          <mrp-space>
            <mrp-button type="primary" @click="handleSubmit" :loading="loading">{{ isEdit ? '更新' : '创建' }}</mrp-button>
            <mrp-button @click="handleReset">重置</mrp-button>
            <mrp-button @click="handleCancel">取消</mrp-button>
          </mrp-space>
        </mrp-form-item>
      </mrp-form>
    </mrp-card>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted, computed } from 'vue'
import { Message } from '@tuhu/shop-mars-pc'
import type { FormInstance } from '@tuhu/shop-mars-pc'
import { useRouter } from 'vue-router' // Vue 3.x
// import { useRouter } from 'vue-router/composables' // Vue 2.7
import ContactForm from './components/ContactForm.vue'
import { createItem, updateItem, getItemDetail } from '@/apis/yourApi'

interface Props {
  id?: string | number
  isEdit?: boolean
}

const props = withDefaults(defineProps<Props>(), {
  isEdit: false
})

const emit = defineEmits<{
  success: [data: any]
  cancel: []
}>()

const router = useRouter()
const formRef = ref<FormInstance>()
const loading = ref(false)
const pageTitle = computed(() => props.isEdit ? '编辑' : '新建')

const formData = reactive({
  name: '',
  type: '',
  contacts: [{ name: '', phone: '' }]
})

const formRules = {
  name: [{ required: true, message: '请输入名称' }],
  type: [{ required: true, message: '请选择类型' }]
}

const typeOptions = ref([
  { label: '类型1', value: '1' }
])

const handleSubmit = async () => {
  if (!formRef.value) return

  try {
    await formRef.value.validate()
    loading.value = true

    if (props.isEdit) {
      await updateItem(props.id, formData)
    } else {
      await createItem(formData)
    }

    Message.success('操作成功')
    emit('success', formData)
    handleCancel()
  } catch (error) {
    Message.error('操作失败')
  } finally {
    loading.value = false
  }
}

const handleReset = () => {
  formRef.value?.resetFields()
}

const handleCancel = () => {
  emit('cancel')
  router.back()
}

const fetchDetail = async () => {
  if (!props.isEdit || !props.id) return

  try {
    loading.value = true
    const response = await getItemDetail(props.id)
    Object.assign(formData, response)
  } catch (error) {
    Message.error('获取数据失败')
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  fetchDetail()
})
</script>

<style scoped lang="scss">
.form-container { padding: 20px; }
</style>
```

## 动态表单组件示例

### ContactForm.vue（联系人表单）

```vue
<template>
  <div class="contact-form">
    <div v-for="(contact, index) in contactList" :key="index" class="form-item">
      <mrp-row :gutter="16">
        <mrp-col :span="8">
          <mrp-form-item :field="`contacts.${index}.name`" :rules="[{ required: true, message: '请输入姓名' }]" hide-label>
            <mrp-input :modelValue="contact.name" @update:modelValue="updateContact(index, 'name', $event)" placeholder="姓名" />
          </mrp-form-item>
        </mrp-col>
        <mrp-col :span="8">
          <mrp-form-item :field="`contacts.${index}.phone`" :rules="[{ required: true, message: '请输入手机号' }]" hide-label>
            <mrp-input :modelValue="contact.phone" @update:modelValue="updateContact(index, 'phone', $event)" placeholder="手机号" />
          </mrp-form-item>
        </mrp-col>
        <mrp-col :span="2">
          <mrp-button type="text" status="danger" @click="removeContact(index)" :disabled="contactList.length <= 1">删除</mrp-button>
        </mrp-col>
      </mrp-row>
    </div>
    <mrp-button type="dashed" @click="addContact">
      <template #icon><icon-plus /></template>
      添加联系人
    </mrp-button>
  </div>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue'
import { IconPlus } from '@tuhu/shop-mars-pc/es/icon'

interface Contact {
  name: string
  phone: string
}

interface Props {
  modelValue: Contact[]
}

const props = withDefaults(defineProps<Props>(), {
  modelValue: () => [{ name: '', phone: '' }]
})

const emit = defineEmits<{
  (e: 'update:modelValue', value: Contact[]): void
}>()

const contactList = ref<Contact[]>([...props.modelValue])

watch(
  () => props.modelValue,
  (newValue) => {
    contactList.value = [...newValue]
  },
  { deep: true }
)

watch(
  contactList,
  (newValue) => {
    emit('update:modelValue', [...newValue])
  },
  { deep: true }
)

const updateContact = (index: number, field: keyof Contact, value: string) => {
  contactList.value[index][field] = value
}

const addContact = () => {
  contactList.value.push({ name: '', phone: '' })
}

const removeContact = (index: number) => {
  if (contactList.value.length > 1) {
    contactList.value.splice(index, 1)
  }
}
</script>

<style scoped lang="scss">
.form-item { margin-bottom: 16px; padding: 16px; border: 1px solid #e5e6eb; border-radius: 6px; }
</style>
```

