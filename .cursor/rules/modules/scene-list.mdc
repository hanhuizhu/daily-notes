### 2. 搜索表单组件（SearchForm.vue）

#### 2.1 简单搜索表单（≤8个字段）

```html
<template>
  <div class="search_form_wrap">
    <mrp-form layout="vertical">
      <mrp-row :gutter="16">
        <mrp-col :span="6">
          <mrp-form-item label="搜索关键词">
            <mrp-input :model-value="formData.searchKey" @update:model-value="handleFieldChange('searchKey', $event)" placeholder="请输入" clearable />
          </mrp-form-item>
        </mrp-col>
        <mrp-col :span="6">
          <mrp-form-item label="状态">
            <mrp-select :model-value="formData.status" @update:model-value="handleFieldChange('status', $event)" :options="statusOptions" clearable />
          </mrp-form-item>
        </mrp-col>
        <mrp-col :span="12">
          <mrp-form-item>
            <mrp-button type="primary" @click="handleSearch">查询</mrp-button>
            <mrp-button @click="handleReset">重置</mrp-button>
            <mrp-button @click="$emit('export')" :loading="exportLoading">导出</mrp-button>
          </mrp-form-item>
        </mrp-col>
      </mrp-row>
    </mrp-form>
  </div>
</template>
```

