```vue
<script setup lang="ts">
import { ref, reactive, watch } from "vue";
import { MrpModal, MrpForm, MrpFormItem, MrpInput, MrpSelect, MrpButton, MrpMessage } from "@tuhu/shop-mars-pc";
import { createItem } from "@/apis";

interface Props {
  modelValue: boolean;
}

const props = defineProps<Props>();

const emit = defineEmits<{
  (e: 'update:modelValue', value: boolean): void;
  (e: 'submit'): void;
}>();

const formRef = ref();
const submitLoading = ref(false);
const statusOptions = ref([]);
const formData = reactive({ name: "", status: "" });

const formRules = {
  name: [{ required: true, message: "请输入名称", trigger: "blur" }],
  status: [{ required: true, message: "请选择状态", trigger: "change" }],
};

watch(() => props.modelValue, (visible) => {
  if (!visible) formRef.value?.resetFields();
});

const handleCancel = (): void => {
  emit('update:modelValue', false);
};

const handleSubmit = async (): Promise<void> => {
  const valid = await formRef.value?.validate();
  if (!valid) return;

  submitLoading.value = true;
  try {
    await createItem(formData);
    MrpMessage.success("新增成功");
    emit('update:modelValue', false);
    emit('submit');
  } catch (error) {
    MrpMessage.error("新增失败");
  } finally {
    submitLoading.value = false;
  }
};
</script>
```

## 使用说明

### 组件结构
- **主页面(ListPage.vue)**: 包含搜索表单、表格展示、弹框引用,负责数据流转和业务逻辑
- **搜索表单(SearchForm.vue)**: 独立的搜索条件表单,支持简单表单和复杂表单(展开收起),通过 props/emit 与主页面通信
- **编辑弹框(EditModal.vue)**: 独立的编辑表单弹框,接收编辑数据作为 props,操作完成后通知主页面刷新
- **新增弹框(AddModal.vue)**: 独立的新增表单弹框,操作完成后通知主页面刷新
