# 列表页面代码模板

## 强制规则
- **调用mcp工具 getMrpComponentsDetail 获取组件文档**
- **接口 response 就是数据本身，禁止 response.data**
- **Vue 2.6/2.7 双向绑定用 :modelValue.sync="xxx"，Vue 3.x 用 v-model**
- **Vue 2.7 路由从 `vue-router/composables` 导入，Vue 2.6 从 `instance?.proxy?.$router`**
- **MrpTable columns 只用 slotName，禁用 render**
- **MrpTable 事件用小驼峰 @pageChange/@pageSizeChange**
- **MrpTable 分页用 :pagination 属性，禁用 MrpPagination 组件**
- **消息提示用 MrpMessage**
- **日期选择器用 MarsPC 组件库**

## 组件拆分
- **搜索表单必须拆分**为 SearchForm.vue
- **表格禁止拆分**，保持在主页面
- **编辑/新增弹框必须拆分**为独立组件

## 代码实现

### 1. 主页面（ListPage.vue）

```html
<template>
  <div class="list_page_wrap">
    <search-form
      :model-value="filterParams"
      @update:model-value="handleFilterChange"
      @search="handleSearch"
      @reset="handleReset"
      @export="handleExport"
      :export-loading="exportLoading"
    />

    <div class="table_wrap">
      <mrp-table
        :data="tableData"
        :columns="tableColumns"
        :loading="tableLoading"
        :pagination="paginationConfig"
        stripe
        border
        @pageChange="handlePageChange"
        @pageSizeChange="handlePageSizeChange"
      >
        <template #status="{ record }">
          <mrp-tag>{{ record.status }}</mrp-tag>
        </template>

        <template #action="{ record }">
          <mrp-button type="primary" @click="handleEdit(record)">编辑</mrp-button>
          <mrp-button type="danger" @click="handleDelete(record.id)">删除</mrp-button>
        </template>
      </mrp-table>
    </div>

    <edit-modal
      :model-value="editModalVisible"
      @update:model-value="editModalVisible = $event"
      :data="currentRowData"
      @submit="handleEditSubmit"
    />

    <add-modal
      :model-value="addModalVisible"
      @update:model-value="addModalVisible = $event"
      @submit="handleAddSubmit"
    />
  </div>
</template>
```

```vue
<script setup lang="ts">
import { ref, reactive, computed, onMounted } from "vue";
import { MrpTable, MrpTag, MrpButton, MrpMessage } from "@tuhu/shop-mars-pc";
import SearchForm from "./components/SearchForm.vue";
import EditModal from "./components/EditModal.vue";
import AddModal from "./components/AddModal.vue";
import { fetchPoiList, deletePoiItem } from "@/apis/poi";
import { formatDateTime } from "./utils";
import type { PoiItem, FilterParams, PaginationParams } from "@/apis/types/poi";

const tableData = ref<PoiItem[]>([]);
const tableLoading = ref(false);
const editModalVisible = ref(false);
const addModalVisible = ref(false);
const currentRowData = ref<PoiItem | null>(null);
const exportLoading = ref(false);

const filterParams = reactive<FilterParams>({
  searchKey: "",
  status: "",
  // ...其他筛选字段
});

const pagination = reactive<PaginationParams>({
  current: 1,
  pageSize: 10,
  total: 0,
});

const paginationConfig = computed(() => ({
  current: pagination.current,
  pageSize: pagination.pageSize,
  total: pagination.total,
  showSizeChanger: true,
  showQuickJumper: true,
  showTotal: true,
  pageSizeOptions: ["10", "20", "50", "100"],
}));

const tableColumns = computed(() => [
  { title: "ID", key: "id", dataIndex: "id", width: 80 },
  { title: "名称", key: "name", dataIndex: "name", width: 200 },
  { title: "状态", key: "status", slotName: "status" },
  { title: "操作", key: "action", slotName: "action", fixed: "right" },
]);

onMounted(() => loadTableData());

const loadTableData = async (): Promise<void> => {
  tableLoading.value = true;
  try {
    const params = { ...filterParams, pageNum: pagination.current, pageSize: pagination.pageSize };
    const response = await fetchPoiList(params);
    tableData.value = response.list || [];
    pagination.total = response.total || 0;
  } catch (error) {
    MrpMessage.error("数据加载失败");
  } finally {
    tableLoading.value = false;
  }
};

const handleFilterChange = (newFilterParams: FilterParams): void => {
  Object.assign(filterParams, newFilterParams);
};

const handleSearch = (): void => {
  pagination.current = 1;
  loadTableData();
};

const handleReset = (resetParams: FilterParams): void => {
  Object.assign(filterParams, resetParams);
  pagination.current = 1;
  loadTableData();
};

const handleExport = async (): Promise<void> => {
  exportLoading.value = true;
  try {
    // TODO: 调用导出接口
    MrpMessage.success("导出成功");
  } catch (error) {
    MrpMessage.error("导出失败");
  } finally {
    exportLoading.value = false;
  }
};

const handlePageChange = (page: number): void => {
  pagination.current = page;
  loadTableData();
};

const handlePageSizeChange = (pageSize: number): void => {
  pagination.pageSize = pageSize;
  pagination.current = 1;
  loadTableData();
};

const handleEdit = (row: PoiItem): void => {
  currentRowData.value = row;
  editModalVisible.value = true;
};

const handleDelete = async (id: string | number): Promise<void> => {
  try {
    await deletePoiItem(id);
    MrpMessage.success("删除成功");
    loadTableData();
  } catch (error) {
    MrpMessage.error("删除失败");
  }
};

const handleEditSubmit = (): void => {
  editModalVisible.value = false;
  loadTableData();
};
</script>
```

