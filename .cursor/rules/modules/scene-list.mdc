```vue
<script setup lang="ts">
import { ref, reactive, watch } from "vue";
import { MrpForm, MrpFormItem, MrpInput, MrpSelect, MrpButton, MrpRow, MrpCol } from "@tuhu/shop-mars-pc";
import type { FilterParams } from "@/apis/types";

interface Props {
  modelValue: FilterParams;
  exportLoading?: boolean;
}

const props = withDefaults(defineProps<Props>(), { exportLoading: false });

const emit = defineEmits<{
  (e: 'update:modelValue', value: FilterParams): void;
  (e: 'search'): void;
  (e: 'reset'): void;
  (e: 'export'): void;
}>();

const formExpanded = ref(false);
const formData = reactive<FilterParams>({ ...props.modelValue });
const options = ref([]);

watch(() => props.modelValue, (newValue) => { Object.assign(formData, newValue); }, { deep: true });

const handleFieldChange = (field: keyof FilterParams, value: any): void => {
  formData[field] = value;
  emit('update:modelValue', { ...formData });
};

const handleSearch = (): void => { emit('search'); };

const handleReset = (): void => {
  Object.assign(formData, {});
  formExpanded.value = false;
  emit('reset');
};
</script>
```

