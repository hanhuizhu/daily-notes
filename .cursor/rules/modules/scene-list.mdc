### 3. 编辑弹框组件（EditModal.vue）

```html
<template>
  <mrp-modal :model-value="modelValue" @update:model-value="$emit('update:modelValue', $event)" title="编辑信息" width="800px">
    <mrp-form ref="formRef" :model="formData" :rules="formRules">
      <mrp-form-item label="名称" prop="name">
        <mrp-input :model-value="formData.name" @update:model-value="formData.name = $event" />
      </mrp-form-item>
      <mrp-form-item label="状态" prop="status">
        <mrp-select :model-value="formData.status" @update:model-value="formData.status = $event" :options="statusOptions" />
      </mrp-form-item>
    </mrp-form>

    <template #footer>
      <mrp-button @click="handleCancel">取消</mrp-button>
      <mrp-button type="primary" :loading="submitLoading" @click="handleSubmit">确定</mrp-button>
    </template>
  </mrp-modal>
</template>
```

```vue
<script setup lang="ts">
import { ref, reactive, watch } from "vue";
import { MrpModal, MrpForm, MrpFormItem, MrpInput, MrpSelect, MrpButton, MrpMessage } from "@tuhu/shop-mars-pc";
import { updateItem } from "@/apis";
import type { Item } from "@/apis/types";

interface Props {
  modelValue: boolean;
  data?: Item | null;
}

const props = withDefaults(defineProps<Props>(), { data: null });

const emit = defineEmits<{
  (e: 'update:modelValue', value: boolean): void;
  (e: 'submit'): void;
}>();

const formRef = ref();
const submitLoading = ref(false);
const statusOptions = ref([]);
const formData = reactive({ id: "", name: "", status: "" });

const formRules = {
  name: [{ required: true, message: "请输入名称", trigger: "blur" }],
  status: [{ required: true, message: "请选择状态", trigger: "change" }],
};

watch(() => props.data, (newData) => {
  if (newData) Object.assign(formData, newData);
}, { immediate: true });

const handleCancel = (): void => {
  emit('update:modelValue', false);
  formRef.value?.resetFields();
};

const handleSubmit = async (): Promise<void> => {
  const valid = await formRef.value?.validate();
  if (!valid) return;

  submitLoading.value = true;
  try {
    await updateItem(formData);
    MrpMessage.success("编辑成功");
    emit('update:modelValue', false);
    emit('submit');
  } catch (error) {
    MrpMessage.error("编辑失败");
  } finally {
    submitLoading.value = false;
  }
};
</script>
```

